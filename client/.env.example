# ==========================================
# SAHARA Client Environment Configuration
# Note: In Vite, all client-exposed variables MUST start with "VITE_"
# ==========================================

# Backend API Base URL (Local Node Server)
VITE_API_BASE_URL=http://localhost:5000

# Direct Backend URL (for uploads / static assets)
VITE_BACKEND_URL=http://localhost:5000

# Application Branding & Metadata
VITE_APP_NAME=SAHARA
VITE_APP_TAGLINE="Give What You Can, Get What You Need"
VITE_APP_ENV=development

# Development & Debugging Flags
VITE_ENABLE_CONSOLE_LOGS=true

